{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dporpatonelis-crypto.github.io/Browser-vr/lesson-map.schema.json",
  "title": "Private lesson-map document, version 1",
  "oneOf": [
    {
      "$ref": "#/$defs/workspace"
    },
    {
      "$ref": "#/$defs/canvas"
    }
  ],
  "$defs": {
    "workspace": {
      "type": "object",
      "required": [
        "schema_version",
        "title",
        "grade",
        "verbs",
        "themes",
        "lessons",
        "connections"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "grade": {
          "type": "string",
          "maxLength": 60
        },
        "verbs": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "icon",
              "box"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "maxLength": 240
              },
              "icon": {
                "type": "string",
                "maxLength": 20
              },
              "box": {
                "$ref": "#/$defs/box"
              }
            },
            "additionalProperties": false
          }
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "theme_id",
              "title",
              "scenario_id",
              "canvas_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "theme_id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "scenario_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "canvas_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        }
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": [
        "schema_version",
        "title",
        "grade",
        "verbs",
        "scenario_id",
        "registered",
        "buildings",
        "annotations",
        "connections",
        "presentation"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "grade": {
          "type": "string",
          "maxLength": 60
        },
        "verbs": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "registered": {
          "type": "boolean"
        },
        "buildings": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/building"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "annotations": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "material_id",
              "kind",
              "points",
              "verb",
              "phrase"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "material_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "enum": [
                  "stroke",
                  "relation",
                  "region"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2000,
                "items": {
                  "$ref": "#/$defs/point"
                }
              },
              "verb": {
                "type": "string",
                "maxLength": 100
              },
              "phrase": {
                "type": "string",
                "maxLength": 600
              }
            },
            "additionalProperties": false
          }
        },
        "presentation": {
          "type": "object",
          "required": [
            "reveal_order",
            "hide_empty"
          ],
          "properties": {
            "reveal_order": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "text",
                  "images",
                  "mindmap",
                  "html",
                  "synthesis"
                ]
              }
            },
            "hide_empty": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "building": {
      "type": "object",
      "required": [
        "id",
        "title",
        "icon",
        "box",
        "hidden",
        "materials"
      ],
      "properties": {
        "id": {
          "enum": [
            "text",
            "images",
            "mindmap",
            "html",
            "synthesis"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 240
        },
        "icon": {
          "type": "string",
          "maxLength": 20
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "hidden": {
          "type": "boolean"
        },
        "materials": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/material"
          }
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "text",
        "url",
        "asset_id",
        "activity_id",
        "source_scenario_id",
        "page_start",
        "page_end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "text",
            "image",
            "pdf",
            "html"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 240
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "url": {
          "type": "string",
          "maxLength": 4096
        },
        "asset_id": {
          "type": "string"
        },
        "activity_id": {
          "type": "string"
        },
        "source_scenario_id": {
          "type": "string"
        },
        "page_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "page_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "verb",
        "phrase",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "verb": {
          "type": "string",
          "maxLength": 100
        },
        "phrase": {
          "type": "string",
          "maxLength": 600
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "y": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "w": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2
        },
        "h": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2
        }
      },
      "additionalProperties": false
    }
  }
}
